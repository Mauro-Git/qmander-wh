# ── Base de datos compartida (misma que trading-dashboard) ─
DATABASE_URL=postgres://usuario:password@host:5432/qmander-db?sslmode=disable

# Mismo valor que ENCRYPTION_KEY en trading-dashboard/.env — lo que cifra el
# dashboard (BrokerAccount.*Enc), lo tiene que poder descifrar el webhook.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Protege /admin/* (logs, kill switch superadmin). Ya NO autentica alertas de
# TradingView — eso ahora es el webhookToken por usuario (ver DB, no env var).
# Genera con: openssl rand -hex 32
ADMIN_SECRET=

PORT=3000

# IPs oficiales de TradingView (separadas por coma)
# Verificar lista vigente en: https://www.tradingview.com/support/solutions/43000529348
TRADINGVIEW_IPS=52.89.214.238,34.212.75.30,54.218.53.128,52.32.178.7

MAX_DAILY_REQUESTS=1500

# ── cTrader Open API (JSON sobre WebSocket, puerto 5036) ─
# App de Spotware compartida por todos los usuarios (el host/accessToken/
# accountId de cada usuario vive en BrokerAccount, ya no en env vars).
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=

LOG_DIR=/app/logs
